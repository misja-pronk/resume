---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getLocale, lpath, ui } from '../i18n';
import { url } from '../utils';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const { Content } = await render(post);

const all = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const index = all.findIndex((p) => p.id === post.id);
const memoNo = `MEMO-${String(all.length - index).padStart(3, '0')}`;

const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));

const fmt = (d: Date) =>
  d
    .toLocaleDateString(locale === 'nl' ? 'nl-NL' : 'en-GB', { day: '2-digit', month: 'long', year: 'numeric' })
    .toUpperCase();
---

<article class="block">
  <a class="back" href={url(lpath(locale, 'blog/'))}>{t.blog.back}</a>

  <header class="memo-head">
    <div class="row">
      <span class="cell"><i>{t.blog.memoNo}</i>{memoNo}</span>
      <span class="cell"><i>{t.blog.date}</i>{fmt(post.data.date)}</span>
      <span class="cell"><i>{t.blog.from}</i>M. PRONK</span>
      <span class="cell"><i>{t.blog.distribution}</i>{t.blog.public}</span>
      <span class="cell"><i>{t.blog.readTime}</i>{minutes} {t.blog.min}</span>
    </div>
    <h1>{post.data.title}</h1>
    {post.data.draft && <span class="draft-stamp">{t.blog.draftStamp}</span>}
  </header>

  <div class="prose">
    <Content />
  </div>

  <footer class="memo-foot">
    <div class="tags">
      {post.data.tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
    <p class="sign">{t.blog.signed}</p>
  </footer>
</article>

<style>
  article {
    max-width: 820px;
  }

  .back {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .memo-head {
    margin-top: 1.6rem;
    position: relative;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    margin-bottom: 1.6rem;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 1.1rem;
    border-right: 1px solid var(--line);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .cell:last-child {
    border-right: none;
  }

  .cell i {
    font-style: normal;
    font-size: 0.52rem;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(1.6rem, 4vw, 2.3rem);
  }

  .draft-stamp {
    display: inline-block;
    margin-top: 1rem;
    border: 3px double var(--stamp);
    color: var(--stamp);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    padding: 0.35rem 0.8rem;
    transform: rotate(-2deg);
  }

  .prose {
    margin-top: 2rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.9;
    max-width: 70ch;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15rem;
  }

  .prose :global(h2) {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.5rem;
    margin: 2.2rem 0 1rem;
  }

  .prose :global(h3) {
    font-family: var(--disp);
    font-size: 1rem;
    color: var(--ink);
    margin: 1.8rem 0 0.8rem;
  }

  .prose :global(strong),
  .prose :global(em) {
    color: var(--ink);
  }

  .prose :global(code) {
    font-size: 0.8em;
    background: var(--accent-soft);
    border: 1px solid var(--line);
    padding: 0.08em 0.35em;
  }

  .prose :global(pre) {
    border: 1px solid var(--line);
    padding: 1.1rem 1.3rem;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.7;
    margin: 0 0 1.15rem;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 0 0 1.15rem;
    padding-left: 1.2rem;
    color: var(--ink);
  }

  .memo-foot {
    margin-top: 2rem;
    border-top: 1px dashed var(--line);
    padding-top: 1.3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .sign {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }
</style>
