---
import { getLocale, ui } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
---

<section id="notes" class="block">
  <h2 class="sheet-title reveal"><span>{t.sheet} 09</span> {t.notes.title}</h2>
  <ol class="gennotes reveal">
    {t.notes.items.map((item) => <li set:html={item} />)}
  </ol>
</section>

<style>
  .gennotes {
    margin: 0;
    padding-left: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    max-width: 76ch;
    line-height: 1.7;
  }

  .gennotes li::marker {
    color: var(--accent);
    font-weight: 700;
  }

  .gennotes :global(b) {
    color: var(--ink);
  }

  .gennotes :global(.wip) {
    color: var(--stamp);
    font-weight: 700;
  }
</style>
