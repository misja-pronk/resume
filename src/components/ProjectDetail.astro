---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getLocale, lpath, ui } from '../i18n';
import { url } from '../utils';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const { Content } = await render(project);

const all = (await getCollection('projects', (p) => p.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const index = all.findIndex((p) => p.id === project.id);
const partNo = `P-${String(all.length - index).padStart(3, '0')}`;
const prev = all[index - 1];
const next = all[index + 1];
const slug = (id: string) => id.replace(`${locale}/`, '');
---

<article class="block">
  <div class="drawing-head">
    <a class="back" href={url(`${lpath(locale, '/')}#projects`)}>{t.detail.back}</a>
    <span class="partno">{partNo}</span>
  </div>

  <header>
    <p class="client">{project.data.client.toUpperCase()}</p>
    <h1>{project.data.title}</h1>
    <div class="facts">
      <div class="fact">
        <span class="label">{t.detail.role}</span>
        <span class="value">{project.data.role}</span>
      </div>
      <div class="fact">
        <span class="label">{t.detail.duration}</span>
        <span class="value">{project.data.ongoing ? t.detail.ongoing : `${project.data.duration} ${t.detail.months}`}</span>
      </div>
      <div class="fact">
        <span class="label">{t.detail.via}</span>
        <span class="value">{project.data.employer}</span>
      </div>
      <div class="fact">
        <span class="label">{t.detail.status}</span>
        <span class={`value ${project.data.ongoing ? 'active' : 'done'}`}>
          {project.data.ongoing ? t.detail.inProgress : t.detail.delivered}
        </span>
      </div>
    </div>
  </header>

  <div class="prose">
    <Content />
  </div>

  <div class="bom">
    <span class="bom-label">{t.detail.bom}</span>
    <div class="tags">
      {project.data.tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
  </div>

  <nav class="pager">
    {prev ? (
      <a class="pager-link" href={url(lpath(locale, `projects/${slug(prev.id)}/`))}>
        <span class="dir">← {t.detail.detail} P-{String(all.length - index + 1).padStart(3, '0')}</span>
        <span class="name">{prev.data.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a class="pager-link next" href={url(lpath(locale, `projects/${slug(next.id)}/`))}>
        <span class="dir">{t.detail.detail} P-{String(all.length - index - 1).padStart(3, '0')} →</span>
        <span class="name">{next.data.title}</span>
      </a>
    )}
  </nav>
</article>

<style>
  article {
    max-width: 860px;
  }

  .drawing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .back {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .partno {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--stamp);
  }

  header {
    margin-top: 2rem;
  }

  .client {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    margin-top: 0.6rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    width: fit-content;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1.3rem;
    border-right: 1px solid var(--line);
  }

  .fact:last-child {
    border-right: none;
  }

  .label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .value {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .value.active {
    color: var(--accent);
  }

  .value.done {
    color: var(--pass);
  }

  .prose {
    margin-top: 2rem;
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.85;
    max-width: 72ch;
  }

  .prose :global(p) {
    margin-bottom: 1.1rem;
  }

  .bom {
    margin-top: 1.6rem;
    border-top: 1px dashed var(--line);
    padding-top: 1.3rem;
  }

  .bom-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    margin-bottom: 0.7rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--line);
    padding: 1rem 1.2rem;
    color: var(--ink);
    transition: all 0.15s;
  }

  .pager-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translate(-2px, -2px);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
  }

  .dir {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--stamp);
  }

  .name {
    font-family: var(--disp);
    font-weight: 600;
    font-size: 0.88rem;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-link.next {
      text-align: left;
    }
  }
</style>
