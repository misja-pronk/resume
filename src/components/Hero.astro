---
import ResumeMenu from './ResumeMenu.astro';
import { getProfile, getStats } from '../data/profile';
import { getLocale, ui } from '../i18n';
import { url } from '../utils';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].hero;
const profile = getProfile(locale);
const stats = getStats(locale);
---

<section class="hero block">
  <div class="fig-row">
    <p class="fig">{t.fig}</p>
    <p class="status-chip"><span class="dot" aria-hidden="true"></span>STATUS: {profile.availability}</p>
  </div>
  <div class="hero-grid">
    <div>
      <h1>
        <span class="dim-line" aria-hidden="true"><i>◄</i>{t.dim}<i>►</i></span>
        {profile.firstName}<br />{profile.lastName}
      </h1>
      <p class="spec-line">
        {t.specType}: <b>{t.specTypeVal}</b> · {t.specMaterials}: <b>{t.specMaterialsVal}</b>
        <small>{t.specAfterHours}</small> · {t.specFinish}: <b>{t.specFinishVal}</b> · {t.specOrigin}: <b>{t.specOriginVal}</b>
      </p>
      <p class="tagline">// {profile.tagline}</p>
      <div class="hero-cta">
        <ResumeMenu size="hero" />
        <a class="btn-bp" href={`mailto:${profile.email}`}>{t.contact}</a>
      </div>
      <dl class="quantities">
        {stats.map((s) => (
          <div class="qty">
            <dd>{s.value}</dd>
            <dt>{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
    <figure class="portrait">
      <span class="tape" aria-hidden="true"></span>
      <div class="photo-frame">
        <img
          src={url(profile.photo)}
          alt={`Portrait of ${profile.firstName} ${profile.lastName}`}
          width="640"
          height="640"
          loading="eager"
        />
        <figcaption>{t.photoCaption}</figcaption>
      </div>
      <span class="stamp">{t.stampTop}<br /><small>{t.stampSub}</small></span>
    </figure>
  </div>

  <svg class="dag" viewBox="0 0 900 150" xmlns="http://www.w3.org/2000/svg" aria-label="Data pipeline schematic">
    <g class="node"><rect x="10" y="45" width="150" height="60" rx="2"/><text x="85" y="70">{t.dagNodes[0]}</text><text x="85" y="88" class="sub">APIs · DBs · FILES</text></g>
    <g class="node"><rect x="240" y="45" width="150" height="60" rx="2"/><text x="315" y="70">{t.dagNodes[1]}</text><text x="315" y="88" class="sub">DATA FACTORY</text></g>
    <g class="node"><rect x="470" y="45" width="150" height="60" rx="2"/><text x="545" y="70">{t.dagNodes[2]}</text><text x="545" y="88" class="sub">DATABRICKS · dbt</text></g>
    <g class="node"><rect x="700" y="45" width="150" height="60" rx="2"/><text x="775" y="70">{t.dagNodes[3]}</text><text x="775" y="88" class="sub">LAKEHOUSE · BI</text></g>
    <g class="wire">
      <path d="M160 75 H240"/><path d="M390 75 H470"/><path d="M620 75 H700"/>
      <circle cx="200" cy="75" r="3"/><circle cx="430" cy="75" r="3"/><circle cx="660" cy="75" r="3"/>
    </g>
    <text x="450" y="20" class="dag-title">{t.dagTitle}</text>
  </svg>
</section>

<style>
  .fig-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .fig {
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    color: var(--accent);
    margin: 0;
  }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    padding: 0.4rem 0.8rem;
    margin: 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f0b429;
    box-shadow: 0 0 0 4px rgba(240, 180, 41, 0.18);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(2.8rem, 7vw, 4.8rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    position: relative;
    padding-top: 1.6rem;
    text-transform: uppercase;
    -webkit-text-stroke: 1px var(--ink);
    color: transparent;
  }

  .dim-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 12%;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--ink-dim);
    -webkit-text-stroke: 0;
    text-transform: none;
  }

  .dim-line::before,
  .dim-line::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--ink-dim);
  }

  .dim-line i {
    font-style: normal;
    font-size: 0.55rem;
  }

  .spec-line {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    padding: 0.7rem 0.9rem;
    margin: 0 0 1.2rem;
  }

  .spec-line b {
    color: var(--accent);
    font-weight: 700;
  }

  .spec-line small {
    color: var(--ink-dim);
    font-size: 0.62rem;
  }

  .tagline {
    color: var(--ink);
    font-size: 0.92rem;
    margin: 0 0 1.6rem;
    max-width: 48ch;
  }

  .hero-cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .quantities {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 2.2rem 0 0;
    border: 1px solid var(--line);
    width: fit-content;
  }

  .qty {
    display: flex;
    flex-direction: column;
    padding: 0.7rem 1.1rem;
    border-right: 1px solid var(--line);
  }

  .qty:last-child {
    border-right: none;
  }

  .qty dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  .qty dt {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    max-width: 9rem;
  }

  /* portrait */
  .portrait {
    margin: 0;
    position: relative;
    transform: rotate(-1.5deg);
    max-width: 420px;
    justify-self: end;
  }

  .photo-frame {
    background: #f5f1e6;
    padding: 10px 10px 12px;
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.55);
  }

  .portrait img {
    width: 100%;
    height: auto;
    filter: contrast(1.06) saturate(1.05);
  }

  .portrait figcaption {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: #4a5568;
    margin-top: 9px;
    text-align: center;
  }

  .tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 110px;
    height: 30px;
    transform: translateX(-50%) rotate(-3deg);
    background: var(--accent-soft);
    border-left: 1px dashed var(--line);
    border-right: 1px dashed var(--line);
    backdrop-filter: blur(1px);
    z-index: 2;
  }

  .stamp {
    position: absolute;
    top: 1rem;
    right: -1rem;
    transform: rotate(12deg);
    border: 3px double var(--stamp);
    color: var(--stamp);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    padding: 0.4rem 0.9rem;
    text-align: center;
    line-height: 1.3;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    opacity: 0.92;
  }

  .stamp small {
    font-size: 0.52rem;
    letter-spacing: 0.25em;
  }

  /* DAG */
  .dag {
    width: 100%;
    margin-top: 2.5rem;
    overflow: visible;
  }

  .dag .node rect {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .dag .node text {
    fill: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 2px;
  }

  .dag .node text.sub {
    fill: var(--ink-dim);
    font-size: 8.5px;
    font-weight: 400;
  }

  .dag .wire path {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
    fill: none;
    animation: flow 1.2s linear infinite;
  }

  .dag .wire circle {
    fill: var(--accent);
  }

  .dag-title {
    fill: var(--ink-dim);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 3px;
    text-anchor: middle;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -10;
    }
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      justify-self: center;
      max-width: 340px;
    }

    .dim-line {
      right: 0;
    }

    .dag {
      display: none;
    }
  }
</style>
