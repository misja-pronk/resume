---
import { getEducation } from '../data/education';
import { getCertifications, getCoursework } from '../data/certifications';
import { getLocale, ui } from '../i18n';
import { url } from '../utils';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const education = getEducation(locale);
const certifications = getCertifications(locale);
const coursework = getCoursework(locale);
---

<section id="education" class="block">
  <h2 class="sheet-title reveal"><span>{t.sheet} 07</span> {t.education.title}</h2>
  <p class="philosophy reveal">{t.education.philosophy}</p>
  <div class="grid">
    {education.map((edu, i) => (
      <div class="edu reveal">
        <header>
          <span class="edu-no">{t.education.fnd} {String(education.length - i).padStart(2, '0')}</span>
          <span class="range">{edu.range}</span>
        </header>
        <h3>{edu.degree}</h3>
        <p class="school">{edu.school}</p>
        {edu.majors && (
          <div class="subjects">
            <span class="label">{edu.minors ? t.education.majors : t.education.subjects}</span>
            <div class="chips">
              {edu.majors.map((m) => <span class="chip">{m}</span>)}
            </div>
          </div>
        )}
        {edu.minors && (
          <div class="subjects">
            <span class="label">{t.education.minors}</span>
            <div class="chips">
              {edu.minors.map((m) => <span class="chip">{m}</span>)}
            </div>
          </div>
        )}
        <a class="diploma" href={url(edu.diploma)} target="_blank" rel="noopener">
          {t.education.diploma}
        </a>
      </div>
    ))}
  </div>

  <div class="credentials reveal">
    <span class="cred-label">{t.education.credentials}</span>
    <ul class="cred-list">
      {certifications.map((c) => (
        <li>
          <a href={c.proof} target="_blank" rel="noopener">{c.name}</a>
          <span class="cred-issuer">— {c.issuer}</span>
        </li>
      ))}
    </ul>
    <p class="cred-note">{coursework}</p>
  </div>
</section>

<style>
  .philosophy {
    max-width: 74ch;
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.8;
    border-left: 2px solid var(--accent);
    padding-left: 1.4rem;
    margin: -0.6rem 0 1.8rem;
  }

  .credentials {
    margin-top: 1.4rem;
    border-top: 1px dashed var(--line);
    padding-top: 1.2rem;
  }

  .cred-label {
    display: block;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    margin-bottom: 0.7rem;
  }

  .cred-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cred-list li {
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .cred-list a {
    font-weight: 700;
    color: var(--ink);
  }

  .cred-list a:hover {
    color: var(--accent);
  }

  .cred-issuer {
    color: var(--ink-dim);
  }

  .cred-note {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    margin-top: 0.9rem;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 1.2rem;
  }

  .edu {
    border: 1px solid var(--line);
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .edu:hover {
    border-color: var(--accent);
  }

  header {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
  }

  .edu-no {
    color: var(--stamp);
    font-weight: 700;
  }

  .range {
    color: var(--accent);
    font-weight: 700;
  }

  h3 {
    font-family: var(--disp);
    font-size: 1.05rem;
  }

  .school {
    color: var(--ink-dim);
    font-size: 0.75rem;
    margin-top: -0.5rem;
  }

  .label {
    display: block;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .diploma {
    margin-top: auto;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
</style>
