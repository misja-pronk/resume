---
import { getTestimonials } from '../data/testimonials';
import { getLocale, ui } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const testimonials = getTestimonials(locale);
const title = locale === 'nl' ? 'KEURINGSRAPPORTEN — REFERENTIES' : 'INSPECTION REPORTS — REFERENCES';
const sourceLabel = locale === 'nl' ? 'BRON' : 'SOURCE';
---

<section id="references" class="block">
  <h2 class="sheet-title reveal"><span>{t.sheet} 03A</span> {title}</h2>
  <div class="quotes">
    {testimonials.map((item) => (
      <figure class="quote reveal">
        <span class="mark" aria-hidden="true">“</span>
        <blockquote>{item.quote}</blockquote>
        <figcaption>
          <span class="author">{item.author}</span>
          <span class="role">{item.role}</span>
          <span class="source">
            {sourceLabel}:{' '}
            {item.sourceUrl ? (
              <a href={item.sourceUrl} target="_blank" rel="noopener">{item.source}</a>
            ) : (
              item.source
            )}
          </span>
        </figcaption>
        <span class="verified">✓</span>
      </figure>
    ))}
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 1.2rem;
  }

  .quote {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-left: 3px solid var(--pass);
    padding: 1.4rem 1.6rem 1.2rem 3.2rem;
  }

  .mark {
    position: absolute;
    top: 0.6rem;
    left: 0.9rem;
    font-family: var(--disp);
    font-size: 2.6rem;
    color: var(--accent);
    line-height: 1;
  }

  blockquote {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--ink);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 1rem;
    border-top: 1px dashed var(--line);
    padding-top: 0.8rem;
  }

  .author {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .role {
    font-size: 0.66rem;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
  }

  .source {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  .verified {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--pass);
    font-size: 0.9rem;
    font-weight: 700;
    border: 1px solid var(--pass);
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    transform: rotate(6deg);
  }
</style>
