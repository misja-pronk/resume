---
import { profile } from '../data/profile';
---

<section id="about" class="block reveal">
  <h2 class="sheet-title"><span>SHT 01</span> DESIGN STATEMENT</h2>
  <div class="statement">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .statement {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 72ch;
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.8;
    border-left: 2px solid var(--accent);
    padding-left: 1.4rem;
  }
</style>
