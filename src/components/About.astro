---
import { getProfile } from '../data/profile';
import { getLocale, ui } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const profile = getProfile(locale);
---

<section id="about" class="block reveal">
  <h2 class="sheet-title"><span>{t.sheet} 01</span> {t.about.title}</h2>
  <div class="statement">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .statement {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 72ch;
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.8;
    border-left: 2px solid var(--accent);
    padding-left: 1.4rem;
  }
</style>
