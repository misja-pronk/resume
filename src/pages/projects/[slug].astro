---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((p) => p.id === project.id);
const partNo = `P-${String(all.length - index).padStart(3, '0')}`;
const prev = all[index - 1];
const next = all[index + 1];
---

<BaseLayout
  title={`${project.data.title} — Misja Pronk`}
  description={project.data.description}
>
  <article class="block">
    <div class="drawing-head">
      <a class="back" href={url('/#projects')}>← FULL DRAWING SET</a>
      <span class="partno">{partNo}</span>
    </div>

    <header>
      <p class="client">{project.data.client.toUpperCase()}</p>
      <h1>{project.data.title}</h1>
      <div class="facts">
        <div class="fact">
          <span class="label">Role</span>
          <span class="value">{project.data.role}</span>
        </div>
        <div class="fact">
          <span class="label">Duration</span>
          <span class="value">{project.data.ongoing ? 'ONGOING' : `${project.data.duration} MONTHS`}</span>
        </div>
        <div class="fact">
          <span class="label">Via</span>
          <span class="value">{project.data.employer}</span>
        </div>
        <div class="fact">
          <span class="label">Status</span>
          <span class={`value ${project.data.ongoing ? 'active' : 'done'}`}>
            {project.data.ongoing ? '● IN PROGRESS' : '✓ DELIVERED'}
          </span>
        </div>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="bom">
      <span class="bom-label">BILL OF MATERIALS</span>
      <div class="tags">
        {project.data.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>

    <nav class="pager">
      {prev ? (
        <a class="pager-link" href={url(`projects/${prev.id}/`)}>
          <span class="dir">← DETAIL P-{String(all.length - index + 1).padStart(3, '0')}</span>
          <span class="name">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager-link next" href={url(`projects/${next.id}/`)}>
          <span class="dir">DETAIL P-{String(all.length - index - 1).padStart(3, '0')} →</span>
          <span class="name">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 860px;
  }

  .drawing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .back {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .partno {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--stamp);
  }

  header {
    margin-top: 2rem;
  }

  .client {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    margin-top: 0.6rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    width: fit-content;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1.3rem;
    border-right: 1px solid var(--line);
  }

  .fact:last-child {
    border-right: none;
  }

  .label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .value {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .value.active {
    color: var(--accent);
  }

  .value.done {
    color: var(--pass);
  }

  .prose {
    margin-top: 2rem;
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.85;
    max-width: 72ch;
  }

  .prose :global(p) {
    margin-bottom: 1.1rem;
  }

  .bom {
    margin-top: 1.6rem;
    border-top: 1px dashed var(--line);
    padding-top: 1.3rem;
  }

  .bom-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    margin-bottom: 0.7rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--line);
    padding: 1rem 1.2rem;
    color: var(--ink);
    transition: all 0.15s;
  }

  .pager-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translate(-2px, -2px);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
  }

  .dir {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--stamp);
  }

  .name {
    font-family: var(--disp);
    font-weight: 600;
    font-size: 0.88rem;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-link.next {
      text-align: left;
    }
  }
</style>
