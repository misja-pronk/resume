---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Sheet not found — Misja Pronk">
  <section class="block notfound">
    <p class="code">ERR-404</p>
    <h1>SHEET NOT FOUND</h1>
    <p class="msg">THIS DRAWING IS NOT ON FILE. AN RFI HAS BEEN LOGGED WITH THE ARCHITECT.</p>
    <a class="btn-bp solid" href={url('/')}>RETURN TO SHEET 1</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    text-align: center;
  }

  .code {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--stamp);
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(2.4rem, 7vw, 4rem);
    -webkit-text-stroke: 1px var(--ink);
    color: transparent;
    letter-spacing: 0.06em;
  }

  .msg {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    max-width: 46ch;
  }
</style>
